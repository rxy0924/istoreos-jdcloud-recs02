# iStoreOS / JDCloud RE-CS-02 (AX6600 雅典娜)
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# 镜像：squashfs 升级包 + initramfs（U-Boot tftp 引导备用）
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# 界面与中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_LUCI_LANG_zh_Hans=y

# iStore 应用商店
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_istore=y
CONFIG_PACKAGE_luci-app-quickstart=y

# Lucky（含后端二进制）
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y

# Clash（luci-app-clash，核心运行时在界面里下载）
CONFIG_PACKAGE_luci-app-clash=y

# OAF（OpenAppFilter：appfilter 服务 + oaf.ko 内核模块 + luci 界面）
CONFIG_PACKAGE_appfilter=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-app-oaf=y
